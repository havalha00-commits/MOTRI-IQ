PORT=3000
DATABASE_URL=postgresql://<role>:<password>@<host>/<database>
JWT_SECRET=<at-least-64-characters>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Object Storage / S3-compatible (Cloudflare R2 OR Backblaze B2) ---
# All values below are placeholders only. NEVER commit real credentials/keys.
# Use dedicated, non-production, isolated bucket/keys ONLY. Never use a Master Application Key.
# Cloudflare R2 = NOT VERIFIED. Backblaze B2 = NOT VERIFIED. Isolated live tests must be explicitly enabled and fail-closed.
# STORAGE_PROVIDER defaults to legacy bucket-per-feature behavior. Set to "b2" or "r2" to store
# logical feature buckets in the configured provider bucket; STORAGE_PREFIX is optional and scopes object keys.
STORAGE_PROVIDER=legacy
STORAGE_PREFIX=
#
# == Cloudflare R2 (S3-compatible) ==
# S3-compatible endpoint (e.g. https://<accountid>.r2.cloudflarestorage.com). Required for real R2 storage operations.
R2_ENDPOINT=
# R2 API access key ID (scope to isolated test bucket only). Required for real R2 storage operations.
R2_ACCESS_KEY_ID=
# R2 API secret access key (scope to isolated test bucket only). Required for real R2 storage operations.
R2_SECRET_ACCESS_KEY=
# Target bucket name. Future isolated Cloudflare R2 tests must use ONLY: motri-iq-r2-isolated-test
R2_BUCKET=
# S3 client region. Cloudflare R2 typically uses "auto".
R2_REGION=auto
# Optional public base URL for public objects (private buckets e.g. wallet_receipts never expose public URLs). Verify before use.
R2_PUBLIC_BASE=

# == Backblaze B2 (S3-compatible; uses existing objectStorage.js + AWS SDK) ==
# B2 S3-compatible endpoint (exact, e.g. https://s3.eu-central-003.backblazeb2.com). Required for real B2 storage operations.
B2_ENDPOINT=
# B2 region (e.g. eu-central-003). Required for real B2 storage operations.
B2_REGION=
# Target bucket name. Isolated B2 integration tests must use ONLY: motri-iq-isolated-test-2026
B2_BUCKET=
# B2 Application Key ID (read from local environment at runtime; NEVER hardcode/commit). Use a restricted, non-master key scoped to the isolated bucket.
B2_KEY_ID=
# B2 Application Key secret (read from local environment at runtime; NEVER hardcode/commit). Use a restricted, non-master key scoped to the isolated bucket.
B2_APPLICATION_KEY=
# Optional public base URL for public objects (private buckets never expose public URLs). Verify before use.
B2_PUBLIC_BASE=
