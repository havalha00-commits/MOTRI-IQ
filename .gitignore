#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing key
/android/key.properties

# Private release material and local audit output
*.jks
*.keystore
*.p12
*.mobileprovision
/config/*.json
!config/*.example.json
flutter_*.log

# Environment/secret files (never commit real credentials). Keep templates/examples only.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.template
!**/.env.*.template

/android/.local-signing/

# Local Google Play upload artifacts
/release/google_play/artifacts/
/release/google_play/*.zip

# Local review evidence and historical copies
/tool/ui_review_artifacts/
/sites/
*.backup*
*.bak
lib/main_fixed.dart

# Local dependency and test scratch directories
**/node_modules/
/backend/.__tmp_b2reg_*/
**/.gradle/
/ios/Flutter/ephemeral/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/android/local.properties

